{
  "name": "voice-elf-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:vad": "../scripts/build-web-vad.sh",
    "build:tts": "../scripts/setup-web-tts.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run build:vad && npm run build:tts && npm run check && vite build",
    "deploy:watch": "npm run build:vad && npm run build:tts && vite build --watch",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "onnxruntime-web": "^1.27.0",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.1.2",
    "svelte-check": "^4.7.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
