{
  "name": "voice-elf-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:vad",
    "dev": "vite --host 0.0.0.0",
    "build:vad": "../scripts/build-web-vad.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run build:vad && npm run check && vite build",
    "deploy:watch": "npm run build:vad && vite build --watch",
    "deploy:public": "../scripts/public-tunnel.sh start production",
    "deploy:public:dev": "../scripts/public-tunnel.sh start dev",
    "deploy:public:restart": "../scripts/public-tunnel.sh restart production",
    "deploy:public:status": "../scripts/public-tunnel.sh status all",
    "deploy:public:stop": "../scripts/public-tunnel.sh stop all",
    "stack:start": "../scripts/dev-stack.sh start",
    "stack:stop": "../scripts/dev-stack.sh stop",
    "stack:restart": "../scripts/dev-stack.sh restart",
    "stack:status": "../scripts/dev-stack.sh status",
    "stack:logs": "../scripts/dev-stack.sh logs",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:android:init": "tauri android init",
    "app:android:dev": "tauri android dev",
    "app:android:build": "tauri android build",
    "app:ios:init": "tauri ios init",
    "app:ios:dev": "tauri ios dev",
    "app:ios:build": "tauri ios build"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "svelte-check": "^4.7.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
