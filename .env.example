# demo: no models required; local: Qwen ASR + local LLM + Qwen3 TTS
VOICE_ELF_BACKEND=demo
VOICE_ELF_BIND=0.0.0.0:3000
VOICE_ELF_MEDIA_DIR=media
VOICE_ELF_INFERENCE_TIMEOUT_SECONDS=600
DATABASE_URL=postgres://localhost/voice_elf

# Required for VOICE_ELF_BACKEND=local
QWEN_ASR_BINARY=/absolute/path/to/qwen_asr
QWEN_ASR_MODEL_DIR=/absolute/path/to/qwen3-asr-0.6b
QWEN_ASR_STREAM_UNFIXED_CHUNKS=0
QWEN_ASR_STREAM_MAX_NEW_TOKENS=12
QWEN_ASR_ENCODER_WINDOW_SECONDS=4

# OpenAI-compatible local endpoint, for example Ollama
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:4b
# LOCAL_LLM_API_KEY=
# Or use llama.cpp directly instead of an HTTP endpoint:
# LOCAL_LLM_BINARY=/absolute/path/to/llama-completion
# LOCAL_LLM_MODEL_PATH=/absolute/path/to/Qwen3-0.6B-Q8_0.gguf
# LOCAL_LLM_THREADS=8

QWEN_TTS_BINARY=/absolute/path/to/generate_audio
QWEN_TTS_MODEL_DIR=/absolute/path/to/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_SPEAKER=vivian
QWEN_TTS_DEVICE=auto
