# Run scripts/setup-local-models.sh before starting the default offline backend.
# Relative filesystem paths below are resolved from the workspace root.
# Initial runtime mode and first ASR default. Later ASR switching is managed in /admin.
VOICE_ELF_BACKEND=local
VOICE_ELF_BIND=0.0.0.0:3001
# Tauri-only upstream, read when building or running the app shell.
VOICE_ELF_APP_SERVER_URL=http://192.168.0.63:3001
VOICE_ELF_MEDIA_DIR=media
VOICE_ELF_INFERENCE_TIMEOUT_SECONDS=600
DATABASE_URL=postgres://localhost/voice_elf

# Deployment authorization. Keep standalone for local/single-instance use.
# Bus: set VOICE_ELF_AUTHORITY_MODE=bus on the central control plane.
# Tenant: configure the three values below only on the self-hosted backend.
VOICE_ELF_AUTHORITY_MODE=standalone
# VOICE_ELF_AUTHORITY_URL=https://authority.example.com
# VOICE_ELF_AUTHORITY_CLIENT_ID=vei_...
# VOICE_ELF_AUTHORITY_CLIENT_SECRET=ves_...
VOICE_ELF_AUTHORITY_CHECK_SECONDS=300
VOICE_ELF_AUTHORITY_TIMEOUT_SECONDS=10
# Optional but recommended before the first start. When omitted, the server
# prints a one-time high-entropy initialization token in its startup log.
# VOICE_ELF_SETUP_TOKEN=replace-with-a-long-random-value

# Account recovery email. smtp.163.com uses the mailbox client authorization
# code as the password; never commit that value. Wrapper TLS is used on port 465.
VOICE_ELF_SMTP_ENABLED=true
VOICE_ELF_SMTP_HOST=smtp.163.com
VOICE_ELF_SMTP_PORT=465
VOICE_ELF_SMTP_SECURITY=wrapper
VOICE_ELF_SMTP_USERNAME=lylapp@163.com
# VOICE_ELF_SMTP_PASSWORD=replace-with-163-client-authorization-code
VOICE_ELF_SMTP_FROM_ADDRESS=lylapp@163.com
VOICE_ELF_SMTP_FROM_NAME=Voice Elf
VOICE_ELF_PASSWORD_RESET_MINUTES=30
# Optional override for reset links, especially for databases initialized before
# the setup wizard stored a public URL.
# VOICE_ELF_PUBLIC_URL=https://voice.example.com

# Server-side TTS. MOSS Nano is attempted first; failures before the first audio
# chunk fall back to the language-specific sherpa-onnx engines below.
TTS_MOSS_NANO_ENABLED=true
TTS_MOSS_NANO_BASE_URL=http://127.0.0.1:18083/
TTS_MOSS_NANO_DEFAULT_DEMO_ID=demo-1
TTS_MOSS_NANO_VOICE_MAP=F1=demo-1,ZH_GENTLE=demo-2,ZH_TAIWAN=demo-3,M1=demo-4,ZH_LECTURE=demo-5,ZH_MONOLOGUE=demo-6,EN_MOSS=demo-7,EN_LECTURE=demo-8,EN_NEWS=demo-9,EN_GENTLE=demo-10,EN_EXPRESSIVE=demo-11,EN_NARRATION=demo-12,JA_NEWS=demo-13
TTS_MOSS_NANO_CPU_THREADS=4
TTS_MOSS_NANO_CONNECT_TIMEOUT_SECONDS=2
TTS_MOSS_NANO_TIMEOUT_SECONDS=180
TTS_MOSS_NANO_RETRY_BACKOFF_SECONDS=30
# TTS_MOSS_NANO_API_KEY=
TTS_INDEX_ENABLED=false
TTS_INDEX_BASE_URL=http://127.0.0.1:18084/
TTS_INDEX_MANAGER_SCRIPT=scripts/index-tts.sh
TTS_INDEX_MODEL_DIR=.local/models/tts/index-tts2
TTS_INDEX_RUNTIME_DIR=.local/run/index-tts
TTS_INDEX_CONNECT_TIMEOUT_SECONDS=3
TTS_INDEX_TIMEOUT_SECONDS=300
TTS_INDEX_RETRY_BACKOFF_SECONDS=30
# TTS_INDEX_API_KEY=
# TTS_INDEX_DEFAULT_VOICE_ID=F1
# TTS_INDEX_DEFAULT_REFERENCE_AUDIO=/absolute/path/to/reference.wav
# TTS_INDEX_VOICE_MAP=F1=/absolute/path/to/f1.wav,M1=/absolute/path/to/m1.wav
TTS_KOKORO_MODEL_DIR=.local/models/tts/kokoro-int8-multi-lang-v1_1
TTS_SUPERTONIC_MODEL_DIR=.local/models/tts/sherpa-onnx-supertonic-3-tts-int8-2026-05-11
TTS_THREADS=2

# Required for VOICE_ELF_BACKEND=local
QWEN_ASR_BINARY=.local/bin/qwen_asr
QWEN_ASR_MODEL_DIR=.local/models/qwen3-asr-0.6b
QWEN_ASR_STREAM_UNFIXED_CHUNKS=0
QWEN_ASR_STREAM_MAX_NEW_TOKENS=32
QWEN_ASR_ENCODER_WINDOW_SECONDS=4

# Optional post-utterance accurate transcription. Start an OpenAI-compatible
# MOSS-Transcribe-Diarize server separately, then enable this component.
MOSS_TRANSCRIBE_ENABLED=false
MOSS_TRANSCRIBE_BASE_URL=http://127.0.0.1:8000/v1
MOSS_TRANSCRIBE_MODEL=OpenMOSS-Team/MOSS-Transcribe-Diarize
# MOSS_TRANSCRIBE_API_KEY=
MOSS_TRANSCRIBE_TIMEOUT_SECONDS=300
MOSS_TRANSCRIBE_MAX_NEW_TOKENS=5120

# OpenAI-compatible local endpoint, for example Ollama (used when MODEL_PATH is unset)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:4b
# LOCAL_LLM_API_KEY=
# Or use llama.cpp directly instead of an HTTP endpoint:
LOCAL_LLM_BINARY=.local/bin/llama-completion
LOCAL_LLM_MODEL_PATH=.local/models/qwen3-0.6b/Qwen3-0.6B-Q8_0.gguf
LOCAL_LLM_THREADS=8
